# PakStore - Apache configuration for InfinityFree

Options -Indexes
DirectoryIndex index.php index.html

# Never allow direct access to source / database / documentation files.
<FilesMatch "\.(sql|md|lock|ini|log|sh|bak|example)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|bun\.lock|config\.local\.php|\.gitignore|\.ftp-deploy-sync-state\.json)$">
    Require all denied
</FilesMatch>

# Block access to hidden files and folders (e.g. .git).
RedirectMatch 404 /\.(?!well-known/)

# Basic security headers.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache static assets for a week (safe for images / CSS / JS).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
